{
  "generator": "synthetic_generator.generate_ensemble",
  "record_months": 1980,
  "state_dim": 20,
  "b_scaling": "||y0 (I - A)^-1 B|| = 1",
  "data": "forced + internal + measurement noise, each centered over the record",
  "forced_rel_rmse": "rms(est - true) / centered_rms(true), denominator = sqrt(V_f / M)",
  "seeds": {
    "w_seed": 22,
    "eig_seed": 20,
    "noise_seed": 0
  },
  "versions": {
    "numpy": "1.24.4",
    "scipy": "1.10.1",
    "scikit-learn": "1.3.2",
    "joblib": "1.3.2",
    "pandas": "2.0.3"
  }
}
